   [calculation]
   name = "CuZn bcc alloy"
   method = "asr"                                # default

   [structure]
   lattice = "bcc"
   alat = 2.85
   centering = "I"
   period = 1                                    # default

   [[sublattice]]
   name = "bcc"
   positions = [[0.0, 0.0, 0.0]]
   species = ["Cu", "Zn"]
   concentrations = [0.5, 0.5]

   [[species]]
   symbol = "Cu"
   z = 29
   nval = 11
   konfig = [4, 4, 3, 4]
   occupations = [1.0, 10.0]
   spin_sign = 1.0                               # default

   [[species]]
   symbol = "Zn"
   z = 30
   nval = 12
   konfig = [4, 4, 3, 4]
   occupations = [2.0, 10.0]
   spin_sign = 1.0                               # default

   [scf]
   spin = 1
   xc = "vbh"
   sim_beta = 1.0
   mixing = 0.3
   max_iterations = 60
   mixing_restart = 0.0                          # default
   tolerance = 1.0E-05                           # default
   zeta0 = 0.1                                   # default
   relativistic = true                           # default
   start_potential = ""                          # default
   save_potential = ""                           # default

   [asr]
   levels = 4
   recursion_steps = 24
   rank = 1
   supercell = 8
   contour_points = 32
   flip_radius = 99                              # default
   cluster_radius = 1.2                          # default
   inversion_radius = 0.0                        # default
   ed_terminator = "hull"                        # default
   fermi_kt = 0.001                              # default
   fermi_poles = 0                               # default
   depth_tol = 1.0E-05                           # default
   ef_scan = 0                                   # default
   ef_scan_step = 2.0E-05                        # default
   ef_scan_center = inf                          # default
   ef_scan_dump = ""                             # default
   route = "edc"                                 # default
   alpha_scale = 1.0                             # default
   energy_block = 0                              # default
   ef_linear_max = 0.0                           # default

   [dos]
   emin = -0.9
   emax = 0.7
   npoints = 401
   eta = 0.02

   [output]
   dos_file = "cuzn_alloy_dos.dat"
   out_file = "asr.out"                          # default

